/target
/.venv

# Generated database (built from the vendored sources on first run)
/data/*.db
/data/*.db-*

# Raw downloaded sources are ignored; the compressed .gz copies under data/
# are committed so the database can be rebuilt offline. (.gz is NOT ignored.)
/data/*.json
/data/morphhb/*.xml
/data/morphgnt/*.txt
/data/ult/*.usfm
/data/lexicon/*.xml
/data/lexicon/*.js

# Publishers' EPUBs of the optional texts: licensed, never committed
/data/*.epub
/data/*.pdf

# The Android build's copy of the database (tools/android-db.sh)
/android/assets/
