import { ComboBox, LineEdit, ScrollView, ListView, Palette, ProgressIndicator } from "std-widgets.slint";

// Typefaces for the tablet, which cannot count on the system having any that
// set pointed, cantillated Hebrew or polytonic Greek well: Gentium Book Plus
// (Latin and Greek, a weight that holds up on e-ink) and Ezra SIL (Hebrew,
// modelled on the BHS). Both SIL Open Font License; see fonts/.
import "fonts/GentiumBookPlus-Regular.ttf";
import "fonts/GentiumBookPlus-Bold.ttf";
import "fonts/EzraSIL-Regular.ttf";

// ---------------------------------------------------------------------------
// Theme — all colours derive from the `dark` and `eink` switches.
// ---------------------------------------------------------------------------
export global Theme {
    in-out property <bool> dark: true;
    /// High contrast for e-ink screens: black on white, and none of the soft
    /// tints, which an e-ink panel turns into muddy grey. Overrides `dark`.
    in-out property <bool> eink: false;
    /// A touch screen (the tablet build): larger targets, buttons for what the
    /// keyboard does, long-press to select, panes that fold away.
    in-out property <bool> touch: false;

    out property <color> bg:        eink ? #ffffff : dark ? #1b1c1f : #fcfbf8;
    out property <color> panel:     eink ? #ffffff : dark ? #232428 : #f2f0ea;
    out property <color> panel-alt: eink ? #e6e6e6 : dark ? #2b2d32 : #e9e6dd;
    out property <color> border:    eink ? #444444 : dark ? #36383e : #ddd8cc;
    out property <color> text:      eink ? #000000 : dark ? #e8e8ea : #1f2329;
    out property <color> muted:     eink ? #333333 : dark ? #9499a1 : #6c7177;
    out property <color> accent:    eink ? #000000 : dark ? #6ea8fe : #2563eb;
    out property <color> accent-bg: eink ? #d4d4d4 : dark ? #2a3550 : #e2ecff;
    out property <color> verse-num: eink ? #444444 : dark ? #7d838d : #9aa0a6;

    out property <color> selection: eink ? #00000038 : dark ? #6ea8fe66 : #2563eb40;
    out property <color> danger:    eink ? #000000 : dark ? #f28b82 : #c5221f;
    out property <bool> dark-widgets: dark && !eink;

    /// Scale of the Bible text, set with Ctrl+plus / Ctrl+minus, the A−/A+
    /// buttons or a pinch. The rest of the interface keeps its size.
    in-out property <float> zoom: 1.0;
    out property <float> min-zoom: 0.6;
    out property <float> max-zoom: 2.5;
    out property <length> reading-size: 17px * root.zoom;
    out property <length> verse-number-size: 12px * root.zoom;

    /// Families for Bible text: the bundled ones on a tablet, the system's
    /// (an empty family) on a desktop.
    out property <string> reading-font: touch ? "Gentium Book Plus" : "";
    out property <string> hebrew-font: touch ? "Ezra SIL" : "";
    /// Height of buttons and list rows: a fingertip needs more than a pointer.
    out property <length> target: touch ? 40px : 28px;

    public function zoom-by(steps: int) {
        root.zoom = max(root.min-zoom, min(root.max-zoom, round(root.zoom * 10 + steps) / 10));
    }
}

// ---------------------------------------------------------------------------
// Paging through a chapter a screenful at a time — the way to read on with an
// e-ink screen, which ghosts through a smooth scroll. Every reading column
// moves when `epoch` is bumped; the leading one calls `past` when there is no
// page left that way, to turn the chapter.
// ---------------------------------------------------------------------------
export global Paging {
    out property <int> epoch;
    out property <int> direction;
    callback past(int);

    public function turn(direction: int) {
        root.direction = direction;
        root.epoch += 1;
    }
}

// ---------------------------------------------------------------------------
// Selecting and copying passages.
//
// Two kinds of selection, one at a time:
//  - words: press on a word of a tagged verse and drag, across verses if need
//    be. A press released without dragging is still a click on the word.
//  - verses: click a verse number to mark it, shift-click another to mark the
//    run between them. Copied verses are headed by their reference.
// Ctrl+C or a verse's context menu copies whichever there is. Prose verses
// (untagged translations) are ordinary selectable text besides.
//
// On a touch screen a drag scrolls, so selecting words starts with a long
// press instead: hold a word, then drag. A tap is still a click on the word.
// Tapping a second verse number extends the mark (there is no shift key), and
// the selection bar along the bottom copies, in place of Ctrl+C and the menus.
//
// Rust formats the text, since it alone holds the words, book names and
// translation codes; the result reaches the clipboard through `clip`, which
// the main window watches.
// ---------------------------------------------------------------------------
export global Passage {
    /// Column the marked verses are in, or -1 when none are marked.
    in-out property <int> column: -1;
    in-out property <int> from;
    in-out property <int> to;
    /// The verse the run was started from; shift-clicks extend from it.
    property <int> anchor;

    /// Column of the word selection, or -1; its ends are word indices of the
    /// open chapter, in either order.
    in-out property <int> word-column: -1;
    property <int> word-anchor;
    property <int> word-end;
    /// A word press is in progress, and where the pointer is, in window
    /// coordinates: each word watches whether it is under it.
    out property <bool> dragging;
    out property <length> pointer-x;
    out property <length> pointer-y;
    property <bool> moved;

    /// Touch: a word is held, not yet long enough to start a selection. The
    /// window's timer calls `hold` if it is still held when it fires.
    out property <bool> armed;
    property <int> armed-column;
    property <int> armed-word;
    property <length> press-x;
    property <length> press-y;

    /// Bumped whenever a selection starts, so the window can take the keys
    /// back from a focused text and Ctrl+C reaches the selection.
    out property <int> focus-epoch;

    /// Text ready for the clipboard, and a counter the window watches.
    out property <string> clip;
    out property <int> clip-epoch;

    /// `column`'s verses `from`..=`to` of the open chapter, with their
    /// reference; `from` 0 means the whole chapter.
    pure callback verses-text(column: int, from: int, to: int) -> string;
    /// `column`'s words `from`..=`to` of the open chapter, as running text.
    pure callback words-text(column: int, from: int, to: int) -> string;

    out property <bool> has-selection: root.column >= 0 || root.word-column >= 0;

    public function mark(column: int, verse: int, extend: bool) {
        root.word-column = -1;
        // touch: a second number extends the mark from the first
        let extending = extend || (Theme.touch && column == root.column && verse != root.anchor);
        if (extending && column == root.column) {
            root.from = min(root.anchor, verse);
            root.to = max(root.anchor, verse);
        } else if (column == root.column && verse == root.from && verse == root.to) {
            // clicking the one marked verse again unmarks it
            root.column = -1;
        } else {
            root.column = column;
            root.anchor = verse;
            root.from = verse;
            root.to = verse;
        }
        root.focus-epoch += 1;
    }

    public pure function is-marked(column: int, verse: int) -> bool {
        column == root.column && verse >= root.from && verse <= root.to
    }

    public function press(column: int, word: int, x: length, y: length) {
        root.column = -1;
        root.word-column = column;
        root.word-anchor = word;
        root.word-end = word;
        root.pointer-x = x;
        root.pointer-y = y;
        root.dragging = true;
        root.moved = false;
        root.focus-epoch += 1;
    }

    public function drag(x: length, y: length) {
        root.pointer-x = x;
        root.pointer-y = y;
        // a finger that wanders before the hold is up is not holding
        if (root.armed && (abs(x - root.press-x) > 10px || abs(y - root.press-y) > 10px)) {
            root.armed = false;
        }
    }

    /// Touch: a word is pressed; it becomes a selection if held.
    public function arm(column: int, word: int, x: length, y: length) {
        root.armed = true;
        root.armed-column = column;
        root.armed-word = word;
        root.press-x = x;
        root.press-y = y;
        root.pointer-x = x;
        root.pointer-y = y;
    }

    /// Touch: the held word starts a selection, which dragging extends.
    public function hold() {
        if (!root.armed) {
            return;
        }
        root.armed = false;
        root.column = -1;
        root.word-column = root.armed-column;
        root.word-anchor = root.armed-word;
        root.word-end = root.armed-word;
        root.dragging = true;
        // a held word is a selection, never a click on release
        root.moved = true;
        root.focus-epoch += 1;
    }

    /// A word reports that the dragging pointer is over it.
    public function reach(column: int, word: int) {
        if (root.dragging && column == root.word-column && word != root.word-end) {
            root.word-end = word;
            root.moved = true;
        }
    }

    /// Ends a press; true when it never left its word, i.e. was a click.
    public function release() -> bool {
        // touch: let go before the hold was up — a tap
        if (root.armed) {
            root.armed = false;
            return true;
        }
        // touch: a press given up to a scroll, or one that wandered off
        if (!root.dragging) {
            return false;
        }
        root.dragging = false;
        if (!root.moved) {
            root.word-column = -1;
            return true;
        }
        false
    }

    public pure function is-selected(column: int, word: int) -> bool {
        column == root.word-column
            && word >= min(root.word-anchor, root.word-end)
            && word <= max(root.word-anchor, root.word-end)
    }

    public function clear() {
        root.column = -1;
        root.word-column = -1;
        root.dragging = false;
        root.armed = false;
    }

    /// What is selected, for the touch selection bar.
    out property <string> summary:
        root.word-column >= 0
            ? (root.word-end == root.word-anchor ? "1 word selected" : (abs(root.word-end - root.word-anchor) + 1) + " words selected")
        : root.column < 0 ? ""
        : root.from == root.to ? "Verse " + root.from + " marked"
        : "Verses " + root.from + "–" + root.to + " marked";

    public function put(text: string) {
        root.clip = text;
        root.clip-epoch += 1;
    }

    public function copy-verses(column: int, from: int, to: int) {
        root.put(root.verses-text(column, from, to));
    }

    /// Copies the selected words or the marked verses; false when there are
    /// neither.
    public function copy-selection() -> bool {
        if (root.word-column >= 0) {
            root.put(root.words-text(root.word-column,
                min(root.word-anchor, root.word-end), max(root.word-anchor, root.word-end)));
            return true;
        }
        if (root.column >= 0) {
            root.copy-verses(root.column, root.from, root.to);
            return true;
        }
        false
    }
}

// ---------------------------------------------------------------------------
// Text the reader can select and copy. Slint's Text cannot be selected at all,
// so this is a read-only TextInput dressed as one: drag or double-click to
// select, Ctrl+C to copy. Like Text it does not wrap unless asked to.
// ---------------------------------------------------------------------------
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    // On a touch screen a drag over text must scroll the page rather than
    // select in it, so there it is plain text; passages are copied through
    // the selection bar instead.
    enabled: !Theme.touch;
    color: Theme.text;
    selection-background-color: Theme.selection;
    selection-foreground-color: Theme.text;
    // A TextInput takes up any slack a layout offers, where Text keeps to
    // its size; keep to Text's manners, and stretch only where asked.
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

// ---------------------------------------------------------------------------
// Shared data structs (mirrored by Rust)
// ---------------------------------------------------------------------------
export struct TranslationItem { code: string, name: string }
export struct BookItem { nr: int, name: string, header: bool }
// A search hit's text, pre-wrapped into lines of words (Slint has no inline
// styling, so a matched word is its own element, highlighted).
export struct HitWord { text: string, hit: bool }
export struct HitLine { words: [HitWord] }
export struct SearchItem {
    label: string,
    snippet: string,
    lines: [HitLine],
    rtl: bool,
    book: int, chapter: int, verse: int,
}

// A word of a tagged verse; `idx` indexes the chapter's flat word list.
export struct WordChip { idx: int, text: string, tagged: bool, rare: bool }

// One row of a reading column. A row is either plain prose (`text`) or a
// sequence of clickable, morphology-tagged words (`words`) — never both.
// Both kinds share one model so that a column is a single ListView, which is
// what lets the two columns lock their scroll positions to each other.
export struct VerseRow {
    verse: int,
    /// Shown instead of the number when the row holds a run of verses, as
    /// in the linked view against a Bible numbering them as one ("1–2").
    label: string,
    text: string,
    words: [WordChip],
    tagged: bool,
    rtl: bool,
}
// One entry of the reader's-edition apparatus: a word rare enough in this
// corpus that a reader is unlikely to know it, glossed and parsed in place so
// no lexicon is needed. Mirrors the footnotes of a printed reader's edition.
export struct GlossItem {
    verse: int,
    surface: string,    // the form as it stands in the text
    lemma: string,      // dictionary headword
    parsing: string,
    gloss: string,
    count: string,      // corpus frequency, e.g. "20×"
    rtl: bool,
}

// One verse across every open translation, for the linked parallel view: a
// cell per column. A cell whose `verse` is 0 is absent in that column —
// versification differs between translations, so a verse can exist in one and
// not another.
export struct PairRow { verse: int, cells: [VerseRow] }

// One open column: the translation in it (an index into the translation list)
// and, when the columns scroll independently, its verses.
export struct ColumnView { translation: int, rows: [VerseRow] }

export struct OriginalWord { text: string, parsing: string }
export struct WordInfo {
    surface: string, translit: string, lemma: string, strongs: string,
    parsing: string, gloss: string, definition: string,
    rtl: bool,          // direction of the clicked surface word
    orig-rtl: bool,     // direction of the original-language script (lemma/originals)
    originals-label: string,
    originals: [OriginalWord],
    lxx: string,
    show-lxx: bool,
    vulgate: string,
    show-vulgate: bool,
}

// ---------------------------------------------------------------------------
// A small text button / pill.
// ---------------------------------------------------------------------------
// Hover tints are for a pointer: on a touch screen the last tap would leave
// one behind, until the next.
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: Theme.target;
    border-radius: 6px;
    background: active ? Theme.accent-bg : ((touch.has-hover && !Theme.touch) ? Theme.panel-alt : transparent);
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: active ? Theme.accent : Theme.text;
            vertical-alignment: center;
            font-size: Theme.touch ? 15px : 13px;
            font-weight: Theme.eink && active ? 700 : 400;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------------------
// A verse number. Clicking it marks the verse for copying; shift-clicking
// another extends the mark to the run between them.
// ---------------------------------------------------------------------------
component VerseNumber inherits Rectangle {
    in property <int> verse;
    in property <string> label;
    in property <int> column;
    in property <bool> tagged;
    /// Leading numbers sit flush against the text; a trailing one (after
    /// right-to-left words) starts from it.
    in property <TextHorizontalAlignment> alignment: right;
    /// A right-click, at this window position: the number's touch area takes
    /// every press, so the verse's menu has to be opened for it.
    callback menu-requested(x: length, y: length);

    width: root.tagged ? 26px : 30px;
    Text {
        width: 100%;
        height: 100%;
        text: root.label != "" ? root.label : root.verse;
        color: (ntouch.has-hover && !Theme.touch) ? Theme.accent : Theme.verse-num;
        font-size: Theme.verse-number-size;
        font-weight: Passage.is-marked(root.column, root.verse) ? 700 : 400;
        horizontal-alignment: root.alignment;
        vertical-alignment: top;
        // nudge the small number to sit on the text baseline
        y: (root.tagged ? 4px : 3px) * Theme.zoom;
    }
    ntouch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                Passage.mark(root.column, root.verse, e.modifiers.shift);
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-requested(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// One verse in one column: the number, then either prose or clickable,
// morphology-tagged words. Shared by the single-column and the paired views so
// both render identically.
// ---------------------------------------------------------------------------
component VerseCell inherits Rectangle {
    in property <VerseRow> verse-row;
    in property <int> column;          // 0 = primary, then left to right
    in property <int> selected-col;
    in property <int> selected-idx;
    /// The verse a search hit was opened on — tinted so the eye lands on it.
    in property <bool> target;
    callback pick(int, int);           // (column, word index)

    property <bool> marked: Passage.is-marked(root.column, root.verse-row.verse);

    property <length> pad-x: 14px;
    property <length> pad-y: root.verse-row.tagged ? 5px : 4px;
    // a fingertip needs a wider number to tap
    property <length> number-width: (root.verse-row.tagged ? 26px : 30px) * Theme.zoom + (Theme.touch ? 10px : 0px);
    property <length> gap: root.verse-row.tagged ? 8px : 10px;
    property <bool> trailing-number: root.verse-row.tagged && root.verse-row.rtl;
    property <length> body-x: root.pad-x + (root.trailing-number ? 0px : root.number-width + root.gap);
    property <length> body-width: max(0px, root.width - 2 * root.pad-x - root.number-width - root.gap);
    property <length> body-height: root.verse-row.tagged ? words.preferred-height : prose.preferred-height;
    preferred-height: root.body-height + 2 * root.pad-y;
    min-height: self.preferred-height;

    // a line the wrap budget mis-sized must not run across the divider
    clip: true;

    // declared first so the word chips above it keep their own clicks; a
    // click on the verse's empty space drops any selection
    vtouch := TouchArea {
        clicked => { Passage.clear(); }
    }
    background: (root.target || root.marked) && root.verse-row.verse > 0
        ? Theme.accent-bg
        : (!root.verse-row.tagged && root.verse-row.verse > 0 && (vtouch.has-hover && !Theme.touch))
            ? Theme.panel
            : transparent;

    function show-menu(x: length, y: length) {
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    // Opened by right-clicks nothing above takes, and by the words, whose
    // touch areas take every press and so open it themselves.
    menu := ContextMenuArea {
        enabled: root.verse-row.verse > 0;
        Menu {
            MenuItem {
                title: Passage.word-column >= 0 ? "Copy selection" : "Copy marked verses";
                enabled: Passage.has-selection;
                activated => { Passage.copy-selection(); }
            }
            MenuItem {
                title: "Copy verse";
                activated => { Passage.copy-verses(root.column, root.verse-row.verse, root.verse-row.verse); }
            }
            MenuItem {
                title: "Copy chapter";
                activated => { Passage.copy-verses(root.column, 0, 0); }
            }
        }

        // Placed by hand rather than by a HorizontalLayout. A layout asks its
        // children for their height at their *preferred* width, and Slint
        // guesses a wrapping flex's preferred width as a squarish block, so
        // the words would be measured wrapped into a narrow column and the
        // row would come out several lines too tall. Here the body is given
        // its real width first and the cell takes the body's height at it.

        // verse number — leading, except after right-to-left words
        if root.verse-row.verse > 0: VerseNumber {
            x: root.trailing-number ? root.body-x + root.body-width + root.gap : root.pad-x;
            y: root.pad-y;
            width: root.number-width;
            height: root.body-height;
            verse: root.verse-row.verse;
            label: root.verse-row.label;
            column: root.column;
            tagged: root.verse-row.tagged;
            alignment: root.trailing-number ? left : right;
            menu-requested(x, y) => { root.show-menu(x, y); }
        }

        // Prose. In a paired row the shorter side is given the taller side's
        // height; the text sits at the top of that space. It has a menu of
        // its own, to copy what is selected in it.
        ContextMenuArea {
            visible: !root.verse-row.tagged;
            enabled: !root.verse-row.tagged;
            x: root.body-x;
            y: root.pad-y;
            width: root.body-width;
            height: prose.preferred-height;
            Menu {
                MenuItem {
                    title: "Copy";
                    // nothing can be selected in the text on a touch screen
                    enabled: !Theme.touch;
                    activated => { prose.copy(); }
                }
                MenuItem {
                    title: "Copy verse";
                    activated => { Passage.copy-verses(root.column, root.verse-row.verse, root.verse-row.verse); }
                }
                MenuItem {
                    title: "Copy marked verses";
                    enabled: Passage.column >= 0;
                    activated => { Passage.copy-selection(); }
                }
                MenuItem {
                    title: "Copy chapter";
                    activated => { Passage.copy-verses(root.column, 0, 0); }
                }
            }
            prose := SelectableText {
                text: root.verse-row.text;
                font-size: Theme.reading-size;
                font-family: root.verse-row.rtl ? Theme.hebrew-font : Theme.reading-font;
                wrap: word-wrap;
                horizontal-alignment: root.verse-row.rtl ? right : left;
                vertical-alignment: top;
            }
        }

        // Tagged words, wrapping to the column: a flex row, reversed for
        // right-to-left scripts so lines fill from the right.
        words := FlexboxLayout {
            visible: root.verse-row.tagged;
            x: root.body-x;
            y: root.pad-y;
            width: root.body-width;
            height: self.preferred-height;
            flex-direction: root.verse-row.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            spacing-horizontal: 3px;
            spacing-vertical: 2px;
            for w in root.verse-row.words: Rectangle {
                // Whether a dragging pointer is over this word. The
                // change handler evaluates it as the chapter is
                // built, before layout has placed anything, so the
                // geometry must not be read unless a drag is on. An
                // `&&` chain is not enough: the compiler hoists the
                // position read above it. An early return is.
                pure function under-pointer() -> bool {
                    if (!Passage.dragging || Passage.word-column != root.column) {
                        return false;
                    }
                    let pos = self.absolute-position;
                    Passage.pointer-x >= pos.x && Passage.pointer-x < pos.x + self.width
                        && Passage.pointer-y >= pos.y && Passage.pointer-y < pos.y + self.height
                }
                property <bool> under: self.under-pointer();
                changed under => {
                    if (self.under) {
                        Passage.reach(root.column, w.idx);
                    }
                }

                property <bool> in-selection: Passage.is-selected(root.column, w.idx);
                border-radius: 4px;
                background: self.in-selection
                    ? transparent
                    : (root.column == root.selected-col && w.idx == root.selected-idx)
                        ? Theme.accent-bg
                        : ((wtouch.has-hover && !Theme.touch) && !Passage.dragging ? Theme.panel-alt : transparent);
                // A selection reads as one run, so its tint spans the
                // gaps between words (half the line's spacing a side).
                Rectangle {
                    x: -1.5px;
                    width: parent.width + 3px;
                    background: parent.in-selection ? Theme.selection : transparent;
                }
                HorizontalLayout {
                    padding: 1px;
                    padding-left: 3px;
                    padding-right: 3px;
                    Text {
                        text: w.text;
                        font-size: Theme.reading-size;
                        font-family: root.verse-row.rtl ? Theme.hebrew-font : Theme.reading-font;
                        color: w.tagged ? Theme.text : Theme.muted;
                    }
                }
                // Reader's edition: a rule under the words the
                // apparatus below glosses. Slint has no text
                // underline, so it is drawn.
                if w.rare: Rectangle {
                    x: 2px;
                    y: parent.height - 2px;
                    width: parent.width - 4px;
                    height: Theme.eink ? 2px : 1px;
                    background: Theme.accent;
                }
                // Press starts a selection; dragging extends it; a
                // release that never left the word is a click, which
                // opens the word study. On a touch screen the press has
                // to be held first (see `Passage`).
                wtouch := TouchArea {
                    pointer-event(e) => {
                        if (Theme.touch && e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            Passage.arm(root.column, w.idx,
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            Passage.press(root.column, w.idx,
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                            if (Passage.release()) {
                                root.pick(root.column, w.idx);
                            }
                        } else if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                            root.show-menu(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        } else if (e.kind == PointerEventKind.cancel) {
                            // the press was taken away (focus lost):
                            // keep what was selected, never a click
                            Passage.release();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            Passage.drag(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Scroll-to-verse, shared by both column kinds.
//
// The columns are a ScrollView over a real VerticalLayout rather than a
// ListView. A chapter is at most 176 verses, so laying every row out is cheap,
// and it buys exactness: a ListView virtualises, positions rows from a moving
// height estimate and recycles row instances, so there is no way to put a
// given row at the top for certain — a search hit would land a verse or two
// off. With a real layout each row's `y` is exact and stable, and landing on a
// verse is simply `content-y = -y`.
//
// Rows publish their `y` when the layout assigns it; the timer reads it a
// moment later, once layout has run.
// ---------------------------------------------------------------------------
component VerseScroller inherits Rectangle {
    vertical-stretch: 1;
    horizontal-stretch: 1;
    /// Bumped by Rust on navigation: back to the top of the new chapter, or
    /// onto `target-index` when a search hit named a verse.
    in property <int> nav-epoch;
    in property <int> target-index: -1;

    // Armed by a navigation with a target; the target row disarms it when it
    // has handed over its position. Guards the row's repeating timer, which
    // otherwise does nothing.
    property <bool> seeking;

    // Called by the target row with its own `y`, read after layout. A row's
    // position cannot be observed with a change callback instead: the tracker
    // would initialise during the row's construction and force the layout to
    // compute while the row is still being built.
    public function land-at(y: length) {
        if (!root.seeking) {
            return;
        }
        // 0 before layout has placed the row (only row 0 sits at 0 for real)
        if (y <= 0px && root.target-index > 0) {
            return;
        }
        // never past the end: the last verses cannot reach the top
        list.content-y = max(-y, list.visible-height - list.content-height);
        root.seeking = false;
    }

    property <int> epoch-watch: root.nav-epoch;
    changed epoch-watch => {
        list.content-y = 0px;
        root.seeking = root.target-index >= 0;
    }

    /// The column that turns the chapter when paged past either end; the
    /// others only follow.
    in property <bool> leads: true;
    property <int> page-watch: Paging.epoch;
    changed page-watch => {
        // a screenful less a couple of lines, so the last line read stays
        // in sight
        let step = max(list.visible-height - 3 * Theme.reading-size, list.visible-height / 2);
        let bottom = min(0px, list.visible-height - list.content-height);
        if (Paging.direction > 0) {
            if (list.content-y <= bottom + 1px) {
                if (root.leads) {
                    Paging.past(1);
                }
            } else {
                list.content-y = max(bottom, list.content-y - step);
            }
        } else {
            if (list.content-y >= -1px) {
                if (root.leads) {
                    Paging.past(-1);
                }
            } else {
                list.content-y = min(0px, list.content-y + step);
            }
        }
    }
    // Created with a target already set (the locked/unlocked views swapping):
    // a change handler would only see edits made after creation.
    init => { root.seeking = root.target-index >= 0; }

    list := ScrollView {
        // Fill the column explicitly. The std ScrollView prefers 100% of its
        // parent, which reads the parent's height inside layout-info and,
        // under the window's FocusScope, closes a loop with the window's own
        // preferred size — so the preferred size is zeroed. But an element
        // with a preferred size defaults to *that* size rather than to its
        // parent's, so without these two lines the scroller is 0×0 and the
        // chapter view is empty.
        width: root.width;
        height: root.height;
        preferred-width: 0px;
        preferred-height: 0px;
        // The Flickable does not size its viewport from a layout placed here
        // through @children, so bind it: the content is exactly as tall as
        // the rows, and no wider than the view (so prose wraps to it).
        content-width: self.visible-width;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: list.visible-width;
            @children
        }
    }
}

// ---------------------------------------------------------------------------
// A single translation, scrolling on its own.
// ---------------------------------------------------------------------------
component ReadingColumn inherits VerseScroller {
    in property <[VerseRow]> rows;
    in property <int> column;
    leads: root.column == 0;
    in property <int> selected-col;
    in property <int> selected-idx;
    callback pick(int, int);

    for r[i] in root.rows: VerseCell {
        verse-row: r;
        column: root.column;
        selected-col: root.selected-col;
        selected-idx: root.selected-idx;
        target: i == root.target-index;
        pick(c, i) => { root.pick(c, i); }
        // only the target row's timer runs; it reads y once layout has run
        Timer {
            interval: 50ms;
            running: i == root.target-index;
            triggered => { root.land-at(parent.y); }
        }
    }
}

// ---------------------------------------------------------------------------
// The linked parallel view: every translation in ONE list, verse beside verse.
//
// This is what makes linked scrolling exact rather than approximate. Separate
// scrollers can only ever be kept in step by estimating where one has got to
// and mapping that onto the others, and they drift apart. Here there is a
// single scroller and a single row per verse, the tallest cell setting the
// height, so the columns cannot come apart at all.
// ---------------------------------------------------------------------------
component PairedColumn inherits VerseScroller {
    in property <[PairRow]> rows;
    /// Columns on screen, 2 to 4: a row has a cell slot for each of the four
    /// a reader can open, and shows the first `count`.
    in property <int> count: 2;
    in property <int> selected-col;
    in property <int> selected-idx;
    callback pick(int, int);

    // A plain Rectangle per row, cells placed by hand — not a HorizontalLayout.
    // A layout row would need each cell's height to size itself, each cell's
    // height depends on its width (wrapped text), and the cell widths would be
    // that same layout's own solved outputs: a height-for-width cycle Slint
    // cannot resolve. Here the widths come straight from the row's width,
    // which the body assigns in its width pass, independent of any height.
    //
    // Four named slots rather than a repeater: the row's height is the
    // tallest of its cells, and Slint can only take a maximum over elements
    // it can name.
    for p[i] in root.rows: Rectangle {
        property <length> cell-width: (self.width - (root.count - 1) * 1px) / root.count;
        height: max(
            max(c0.preferred-height, c1.preferred-height),
            max(root.count > 2 ? c2.preferred-height : 0px, root.count > 3 ? c3.preferred-height : 0px));
        // only the target row's timer runs; it reads y once layout has run
        Timer {
            interval: 50ms;
            running: i == root.target-index;
            triggered => { root.land-at(parent.y); }
        }
        c0 := VerseCell {
            x: 0;
            width: parent.cell-width;
            height: parent.height;
            verse-row: p.cells[0];
            column: 0;
            selected-col: root.selected-col;
            selected-idx: root.selected-idx;
            target: i == root.target-index;
            pick(c, w) => { root.pick(c, w); }
        }
        c1 := VerseCell {
            x: parent.cell-width + 1px;
            width: parent.cell-width;
            height: parent.height;
            verse-row: p.cells[1];
            column: 1;
            selected-col: root.selected-col;
            selected-idx: root.selected-idx;
            target: i == root.target-index;
            pick(c, w) => { root.pick(c, w); }
        }
        c2 := VerseCell {
            visible: root.count > 2;
            x: 2 * (parent.cell-width + 1px);
            width: parent.cell-width;
            height: parent.height;
            verse-row: p.cells[2];
            column: 2;
            selected-col: root.selected-col;
            selected-idx: root.selected-idx;
            target: i == root.target-index;
            pick(c, w) => { root.pick(c, w); }
        }
        c3 := VerseCell {
            visible: root.count > 3;
            x: 3 * (parent.cell-width + 1px);
            width: parent.cell-width;
            height: parent.height;
            verse-row: p.cells[3];
            column: 3;
            selected-col: root.selected-col;
            selected-idx: root.selected-idx;
            target: i == root.target-index;
            pick(c, w) => { root.pick(c, w); }
        }
        for d in root.count - 1: Rectangle {
            x: (d + 1) * (parent.cell-width + 1px) - 1px;
            width: 1px;
            height: parent.height;
            background: Theme.border;
        }
    }
}

// ---------------------------------------------------------------------------
// The reader's-edition apparatus: the rare words of the open chapter, glossed
// and parsed, in reading order. This is the footnote block of a printed
// reader's edition — it exists so the chapter can be read straight through
// without reaching for a lexicon.
// ---------------------------------------------------------------------------
component GlossPane inherits Rectangle {
    in property <[GlossItem]> notes;
    in property <string> caption;
    background: Theme.panel;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;

        Text {
            text: root.caption;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 700;
        }

        if root.notes.length == 0: Text {
            text: "No words below the frequency threshold in this chapter.";
            color: Theme.muted;
            font-size: 13px;
        }

        ListView {
            vertical-stretch: 1;
            for g in root.notes: Rectangle {
                background: (gtouch.has-hover && !Theme.touch) ? Theme.panel-alt : transparent;
                border-radius: 4px;
                gtouch := TouchArea { }
                // No `alignment` — the columns have to line up down the
                // page, so the gloss takes the slack and everything after it
                // stays put.
                HorizontalLayout {
                    padding: 3px;
                    spacing: 8px;

                    Text {
                        text: g.verse;
                        width: 26px;
                        color: Theme.verse-num;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: top;
                        y: 3px;
                    }
                    // The original-language forms sit in their own Text
                    // elements so a right-to-left script never reorders the
                    // Latin gloss beside it.
                    SelectableText {
                        text: g.surface;
                        width: 110px;
                        color: Theme.text;
                        font-size: Theme.reading-size;
                        font-family: g.rtl ? Theme.hebrew-font : Theme.reading-font;
                        horizontal-alignment: g.rtl ? right : left;
                    }
                    SelectableText {
                        text: g.lemma;
                        width: 100px;
                        color: Theme.muted;
                        font-size: 15px;
                        font-family: g.rtl ? Theme.hebrew-font : Theme.reading-font;
                        horizontal-alignment: g.rtl ? right : left;
                    }
                    SelectableText {
                        text: g.gloss;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    SelectableText {
                        text: g.parsing;
                        width: 210px;
                        color: Theme.accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: g.count;
                        width: 44px;
                        color: Theme.muted;
                        font-size: 12px;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The reading area: one to four translations side by side — linked into a
// single list, or scrolling independently. Each column is headed by the
// picker for its translation.
// ---------------------------------------------------------------------------
component ParallelColumns inherits Rectangle {
    in property <[string]> translation-labels;
    in property <[ColumnView]> columns;
    in property <[PairRow]> pairs;
    in property <bool> scroll-lock;
    in property <int> selected-col;
    in property <int> selected-idx;
    in property <int> nav-epoch;
    in property <int> target-index: -1;
    callback pick(int, int);
    callback translation-changed(int, int);  // (column, translation index)
    callback remove-column(int);

    property <bool> linked: root.scroll-lock && root.columns.length > 1;

    // Columns are equal shares of the width: equal stretch with zeroed
    // preferred/minimum widths, never a `width: parent.width / n` binding,
    // which would ask a layout for its output while it is still being solved.
    // Each column after the first draws the divider on its left edge, so the
    // headings and the text below share one grid.
    VerticalLayout {
        HorizontalLayout {
            height: 40px;
            for c[i] in root.columns: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                if i > 0: Rectangle {
                    x: 0;
                    width: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding: 6px;
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 6px;
                    ComboBox {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        max-width: 420px;
                        model: root.translation-labels;
                        current-index: c.translation;
                        selected(v) => { root.translation-changed(i, self.current-index); }
                    }
                    // the picker keeps to its width; the slack sits before
                    // the close button, which stays at the column's edge
                    Rectangle { horizontal-stretch: 1; }
                    if root.columns.length > 1: VerticalLayout {
                        alignment: center;
                        Pill {
                            label: "✕";
                            clicked => { root.remove-column(i); }
                        }
                    }
                }
            }
        }

        if root.linked: PairedColumn {
            rows: root.pairs;
            count: root.columns.length;
            selected-col: root.selected-col;
            selected-idx: root.selected-idx;
            nav-epoch: root.nav-epoch;
            target-index: root.target-index;
            pick(c, w) => { root.pick(c, w); }
        }

        // Unlinked (or a single column): a list per column, each minding its
        // own scroll position. Nothing keeps them in step, which is the point.
        if !root.linked: HorizontalLayout {
            for c[i] in root.columns: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                if i > 0: Rectangle {
                    x: 0;
                    width: 1px;
                    background: Theme.border;
                }
                ReadingColumn {
                    x: i > 0 ? 1px : 0px;
                    width: parent.width - self.x;
                    height: parent.height;
                    rows: c.rows;
                    column: i;
                    selected-col: root.selected-col;
                    selected-idx: root.selected-idx;
                    nav-epoch: root.nav-epoch;
                    target-index: root.target-index;
                    pick(col, w) => { root.pick(col, w); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The book and chapter lists, with the reader's cut-off: beside the text, or
// over it on a narrow screen.
// ---------------------------------------------------------------------------
component Sidebar inherits Rectangle {
    in property <bool> reader-on;
    in property <[string]> threshold-labels;
    in property <int> threshold-index;
    in property <[BookItem]> books;
    in property <[int]> chapters;
    in property <int> current-book;
    in property <int> current-chapter;
    callback threshold-changed(int);
    callback select-book(int);
    callback select-chapter(int);

    background: Theme.panel;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        if root.reader-on: Text {
            text: "Gloss words rarer than";
            color: Theme.muted;
            font-size: 11px;
        }
        if root.reader-on: ComboBox {
            model: root.threshold-labels;
            current-index: root.threshold-index;
            selected(v) => { root.threshold-changed(self.current-index); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // book list
        Text { text: "Books"; color: Theme.muted; font-size: 11px; }
        ListView {
            vertical-stretch: 1;
            for b[i] in root.books: Rectangle {
                height: b.header ? 30px : (Theme.touch ? 44px : 26px);
                background: (!b.header && b.nr == root.current-book)
                    ? Theme.accent-bg
                    : ((btouch.has-hover && !Theme.touch) && !b.header ? Theme.panel-alt : transparent);
                border-radius: 5px;
                HorizontalLayout {
                    padding-left: b.header ? 4px : 12px;
                    Text {
                        text: b.name;
                        vertical-alignment: center;
                        font-size: b.header ? 11px : (Theme.touch ? 17px : 14px);
                        font-weight: b.header ? 700 : 400;
                        color: b.header
                            ? Theme.muted
                            : (b.nr == root.current-book ? Theme.accent : Theme.text);
                    }
                }
                btouch := TouchArea {
                    enabled: !b.header;
                    clicked => { root.select-book(b.nr); }
                }
            }
        }

        // chapter grid
        Text {
            text: "Chapters";
            color: Theme.muted;
            font-size: 11px;
            visible: root.chapters.length > 0;
        }
        // Sizes to fit all chapters; caps and scrolls only when the
        // grid would get too tall (e.g. Psalms' 150 chapters).
        // content-height must be set explicitly: the cells are
        // absolutely positioned, so the ScrollView can't infer it.
        csv := ScrollView {
            // the tablet's sidebar is 330px wide: six cells a row, each big
            // enough for a fingertip
            property <int> cols: Theme.touch ? 6 : 7;
            property <length> cell: Theme.touch ? 50px : 34px;
            property <length> content-h: Math.ceil(root.chapters.length / self.cols) * self.cell;
            visible: root.chapters.length > 0;
            content-width: self.cols * self.cell;
            content-height: self.content-h;
            height: Math.min(self.content-h + 2px, Theme.touch ? 410px : 300px);
            for ch[i] in root.chapters: Rectangle {
                x: Math.mod(i, csv.cols) * csv.cell;
                y: Math.floor(i / csv.cols) * csv.cell;
                width: csv.cell - 4px;
                height: csv.cell - 4px;
                border-radius: 5px;
                border-width: 1px;
                border-color: ch == root.current-chapter ? Theme.accent : Theme.border;
                background: ch == root.current-chapter
                    ? Theme.accent-bg
                    : ((chtouch.has-hover && !Theme.touch) ? Theme.panel-alt : transparent);
                Text {
                    text: ch;
                    font-size: Theme.touch ? 16px : 12px;
                    color: ch == root.current-chapter ? Theme.accent : Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                chtouch := TouchArea { clicked => { root.select-chapter(ch); } }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Word study: the clicked word, its lexicon entry, and the original-language
// word(s) and ancient versions behind it.
// ---------------------------------------------------------------------------
component WordPanel inherits Rectangle {
    in property <WordInfo> word;
    callback close();

    background: Theme.panel;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: "Word study";
                color: Theme.muted;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Pill { label: "✕"; clicked => { root.close(); } }
        }
        SelectableText {
            text: root.word.surface;
            color: Theme.text;
            font-size: 30px;
            font-family: root.word.rtl ? Theme.hebrew-font : Theme.reading-font;
            horizontal-alignment: root.word.rtl ? right : left;
        }
        if root.word.translit != "": SelectableText {
            text: root.word.translit;
            color: Theme.muted;
            font-size: 15px;
        }
        if root.word.strongs != "": HorizontalLayout {
            spacing: 8px;
            Rectangle {
                background: Theme.accent-bg;
                border-radius: 5px;
                height: 22px;
                horizontal-stretch: 0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    SelectableText {
                        text: root.word.strongs;
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            SelectableText {
                text: root.word.lemma;
                font-family: root.word.orig-rtl ? Theme.hebrew-font : Theme.reading-font;
                color: Theme.text;
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        if root.word.parsing != "": SelectableText {
            text: root.word.parsing;
            color: Theme.accent;
            font-size: 14px;
            wrap: word-wrap;
        }
        // matching original-language word(s) — reverse interlinear
        if root.word.originals-label != "": Text {
            text: root.word.originals-label;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 700;
        }
        for o in root.word.originals: HorizontalLayout {
            spacing: 10px;
            SelectableText {
                text: o.text;
                font-family: root.word.orig-rtl ? Theme.hebrew-font : Theme.reading-font;
                color: Theme.accent;
                font-size: 22px;
            }
            SelectableText {
                text: o.parsing;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.word.gloss != "": SelectableText {
            text: root.word.gloss;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: Theme.border; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: 100%;
                spacing: 8px;
                // the entry reads from the top; slack goes
                // below it, not between its parts
                alignment: start;
                SelectableText {
                    width: 100%;
                    text: root.word.definition;
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                if root.word.show-lxx: Text {
                    text: "Septuagint (LXX)";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                if root.word.show-lxx: SelectableText {
                    width: 100%;
                    text: root.word.lxx;
                    font-family: Theme.reading-font;
                    color: Theme.text;
                    font-size: 16px;
                    wrap: word-wrap;
                }
                if root.word.show-vulgate: Text {
                    text: "Vulgate (Latin)";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 700;
                }
                if root.word.show-vulgate: SelectableText {
                    width: 100%;
                    text: root.word.vulgate;
                    font-family: Theme.reading-font;
                    color: Theme.text;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The advanced-search reference card, a column at a time. The card lays the
// three side by side, or one above another on a narrow screen.
// ---------------------------------------------------------------------------
component QueryWords inherits VerticalLayout {
    spacing: 3px;
    alignment: start;
    Text { text: "ONE WORD"; color: Theme.muted; font-size: 10px; font-weight: 700; }
    HorizontalLayout { spacing: 10px;
        Text { text: "G25   H430"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "Strong's number"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "lemma:ἀγαπάω"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "dictionary form (accents optional)"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "gloss:love"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "lexemes whose gloss says it"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "θεο*   “ὁ θεός”"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "surface prefix · exact phrase"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "[G25 aorist active]"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "several constraints on the SAME word"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
}

component QueryMorphology inherits VerticalLayout {
    spacing: 3px;
    alignment: start;
    Text { text: "MORPHOLOGY — field:value, or just the value"; color: Theme.muted; font-size: 10px; font-weight: 700; }
    HorizontalLayout { spacing: 10px;
        Text { text: "pos:"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "verb noun adjective article pronoun preposition conjunction adverb particle name"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "tense:"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "present imperfect future aorist perfect pluperfect · wayyiqtol weqatal cohortative jussive"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "voice: mood: case:"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "active middle passive · indicative imperative subjunctive optative infinitive participle · nominative genitive dative accusative vocative"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "number: gender: person:"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "singular plural dual · masculine feminine neuter · 1 2 3"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "stem: state:"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "qal niphal piel hiphil hophal hithpael … · absolute construct · alternate with |: tense:aorist|perfect"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
}

component QueryCombining inherits VerticalLayout {
    spacing: 3px;
    alignment: start;
    callback try(string);
    Text { text: "COMBINING"; color: Theme.muted; font-size: 10px; font-weight: 700; }
    HorizontalLayout { spacing: 10px;
        Text { text: "A B · A AND B"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "both in the verse"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "A OR B · NOT A · ( )"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "either · exclude · group"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 10px;
        Text { text: "A BEFORE/2 B"; width: 140px; color: Theme.accent; font-size: 11px; font-weight: 600; }
        Text { text: "A within two words before B · AFTER/n · NEAR/n either side · no /n = anywhere in the verse"; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
    }
    Text { text: "TRY"; color: Theme.muted; font-size: 10px; font-weight: 700; }
    VerticalLayout {
        spacing: 4px;
        alignment: start;
        Pill { label: "[G25 aorist]"; clicked => { root.try("[G25 aorist]"); } }
        Pill { label: "[verb aorist] BEFORE/1 lemma:θεός"; clicked => { root.try("[verb aorist] BEFORE/1 lemma:θεός"); } }
        Pill { label: "[H430 plural] NEAR/2 [verb hiphil]"; clicked => { root.try("[H430 plural] NEAR/2 [verb hiphil]"); } }
    }
}

// ---------------------------------------------------------------------------
// The toolbar's buttons: in the top bar, or on a row of their own on a narrow
// screen.
// ---------------------------------------------------------------------------
component Tools inherits HorizontalLayout {
    in property <bool> advanced;
    in-out property <bool> show-import;
    in property <bool> can-import;
    in property <int> column-count;
    in property <bool> reader-available;
    in property <bool> reader;
    in property <bool> scroll-lock;
    /// Short labels, to fit a narrow screen.
    in property <bool> short;
    callback toggle-advanced();
    callback add-column();
    callback toggle-reader();
    callback toggle-scroll-lock();
    callback toggle-theme();
    callback zoom-changed();

    spacing: root.short ? 8px : 12px;
    // Each item is vertically centered so the buttons share one baseline
    // with the search box.
    VerticalLayout {
        alignment: center;
        Pill {
            label: root.short ? "⌕ Query" : root.advanced ? "⌕ Advanced ✓" : "⌕ Advanced";
            active: root.advanced;
            clicked => { root.toggle-advanced(); }
        }
    }
    if root.can-import: VerticalLayout {
        alignment: center;
        Pill {
            label: "⇪ Import";
            active: root.show-import;
            clicked => { root.show-import = !root.show-import; }
        }
    }
    // Four columns at most: beyond that a verse is a word or two per line.
    if root.column-count < 4: VerticalLayout {
        alignment: center;
        Pill {
            label: "＋ Column";
            clicked => { root.add-column(); }
        }
    }
    if root.reader-available: VerticalLayout {
        alignment: center;
        Pill {
            label: root.short ? "📖 Reader" : root.reader ? "📖 Reader ✓" : "📖 Reader";
            active: root.reader;
            clicked => { root.toggle-reader(); }
        }
    }
    if root.column-count > 1: VerticalLayout {
        alignment: center;
        Pill {
            label: root.scroll-lock ? "🔗 Linked" : "⛓ Unlinked";
            active: root.scroll-lock;
            clicked => { root.toggle-scroll-lock(); }
        }
    }
    // Text size: the keyboard has Ctrl+plus and Ctrl+minus, a touch screen a
    // pinch and these.
    if Theme.touch: VerticalLayout {
        alignment: center;
        Pill {
            label: "A−";
            clicked => {
                Theme.zoom-by(-1);
                root.zoom-changed();
            }
        }
    }
    if Theme.touch: VerticalLayout {
        alignment: center;
        Pill {
            label: "A+";
            clicked => {
                Theme.zoom-by(1);
                root.zoom-changed();
            }
        }
    }
    // Names the theme a click switches to: light, dark, and on a touch
    // screen e-ink, in turn.
    VerticalLayout {
        alignment: center;
        Pill {
            label: Theme.eink ? "☀ Light" : !Theme.dark ? "🌙 Dark" : Theme.touch ? "◐ E-ink" : "☀ Light";
            clicked => { root.toggle-theme(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "LeVerbe";
    icon: @image-url("icon.png");
    preferred-width: 1200px;
    preferred-height: 820px;
    // a tablet's window is its screen, whichever way up
    min-width: Theme.touch ? 0px : 720px;
    min-height: Theme.touch ? 0px : 480px;
    background: Theme.bg;

    // --- data in from Rust ---
    in property <[TranslationItem]> translations;
    in property <[string]> translation-labels;
    in property <[BookItem]> books;
    in property <[int]> chapters;
    /// The open columns, 1 to 4; the first is the primary text, which sets
    /// the book list, the search and the reader's edition.
    in property <[ColumnView]> columns;
    in property <[PairRow]> pairs;      // all columns as one list (linked)
    in property <[SearchItem]> results;

    // reader's edition
    in property <[GlossItem]> notes;
    in property <string> reader-caption;
    in property <[string]> threshold-labels;
    in property <int> threshold-index;
    /// True when the primary translation carries per-word morphology, which is
    /// what the apparatus is built from.
    in property <bool> reader-available;
    in-out property <bool> reader;

    // word study
    in property <WordInfo> word;
    in-out property <bool> show-word;
    in-out property <int> selected-col: -1;
    in-out property <int> selected-idx: -1;
    in property <string> primary-title;
    in property <string> results-summary;

    in-out property <int> current-book;
    in-out property <int> current-chapter;
    in-out property <bool> show-results;
    in-out property <string> command;

    // --- parallel scroll locking ---
    // On by default: the columns scroll together, verse beside verse. Rust
    // resets them to the top on navigation.
    in-out property <bool> scroll-lock: true;
    /// Bumped by Rust whenever the passage changes, to send the columns back
    /// to the top of the new chapter — or to `target-index`, the row of a
    /// search hit, when that is set.
    in property <int> nav-epoch;
    in property <int> target-index: -1;
    /// Bumped by Rust for each new search: the results list returns to its top
    /// for a new query, but keeps its place when coming back from a hit.
    in property <int> search-epoch;
    /// Incremented to move keyboard focus into the search box (Ctrl+F).
    in-out property <int> focus-search;
    /// The advanced-search panel (Ctrl+Shift+F): the query language's
    /// reference card, with examples that fill the search box.
    in-out property <bool> advanced;
    property <bool> has-results: root.results.length > 0;

    // --- tablet layout ---
    /// Too narrow for the panes to sit beside the text (a tablet held
    /// upright): the sidebar and the word study lie over it instead, and the
    /// toolbar takes a row of its own.
    ///
    /// Set when the width changes rather than bound to it: the window's own
    /// size is computed from a layout that `compact` rearranges, a loop a
    /// binding cannot have.
    out property <bool> compact;
    function fit() {
        root.compact = Theme.touch && root.width < 1100px;
    }
    changed width => { root.fit(); }
    property <bool> touch-watch: Theme.touch;
    changed touch-watch => { root.fit(); }
    /// The sidebar beside the text; a touch screen can fold it away.
    in-out property <bool> show-sidebar: true;
    property <bool> docked-sidebar: !root.compact && (!Theme.touch || root.show-sidebar);
    /// The sidebar over the text, when compact.
    in-out property <bool> drawer-open;
    /// Importing needs a file dialog, which the tablet build does not have.
    in property <bool> can-import: true;
    /// First launch on a tablet: the database is being unpacked.
    in property <bool> preparing;
    in property <float> prepare-progress;
    in property <string> prepare-error;

    // --- callbacks to Rust ---
    callback select-book(int);
    callback select-chapter(int);
    callback go(string);
    callback open-result(int);
    callback translation-changed(int, int);  // (column, translation index)
    callback add-column();
    callback remove-column(int);
    callback toggle-theme();
    callback prev-chapter();
    callback next-chapter();
    callback close-results();
    callback word-clicked(int, int);  // (column, word index)
    callback close-word();
    callback toggle-reader();
    callback toggle-scroll-lock();
    callback toggle-advanced();
    callback zoom-changed();

    // --- importing a translation from a file ---
    in-out property <bool> show-import;
    /// 0 choosing a file, 1 confirming what was read, 2 importing, 3 done.
    in property <int> import-stage;
    in property <[TranslationItem]> imported;
    in property <string> import-file;
    in property <string> import-summary;
    in property <string> import-notes;
    in property <string> import-error;
    in property <string> import-progress-text;
    in property <float> import-progress;
    in-out property <string> import-name;
    in-out property <string> import-code;
    in-out property <string> import-lang;
    /// The imported translation whose Remove was clicked once.
    property <string> removing;
    callback import-choose();
    callback import-confirm();
    callback import-reset();
    callback import-open();
    callback import-remove(string);
    callback threshold-changed(int);

    // The std-widgets (combo boxes, the search field) take their colours from
    // the *system* scheme, not from Theme, so in light mode they would keep
    // painting light text on our light panel. Keep the two in step.
    property <bool> dark-watch: Theme.dark-widgets;
    function sync-widget-scheme() {
        Palette.color-scheme = Theme.dark-widgets ? ColorScheme.dark : ColorScheme.light;
    }

    /// An example from the reference card, into the search box.
    function try-query(query: string) {
        root.command = query;
        root.focus-search += 1;
    }

    function toggle-sidebar() {
        if (root.compact) {
            root.drawer-open = !root.drawer-open;
        } else {
            root.show-sidebar = !root.show-sidebar;
        }
    }

    /// Android's back key: closes whatever was opened last, and only then
    /// leaves the app (false).
    function go-back() -> bool {
        if (root.show-import) {
            if (root.import-stage != 2) {
                root.show-import = false;
            }
            return true;
        }
        if (root.drawer-open) {
            root.drawer-open = false;
            return true;
        }
        if (root.show-word) {
            root.close-word();
            return true;
        }
        if (Passage.has-selection) {
            Passage.clear();
            return true;
        }
        if (root.advanced) {
            root.toggle-advanced();
            return true;
        }
        if (root.show-results) {
            root.show-results = false;
            return true;
        }
        false
    }
    changed dark-watch => { root.sync-widget-scheme(); }
    // Keys reach nothing unless something has focus, so start on the shortcut
    // scope; the search box, when focused, is inside it, and the scope sees
    // keys in the capture phase before the box does.
    init => {
        root.sync-widget-scheme();
        root.fit();
        shortcuts.focus();
    }

    // Slint gives Rust no way to write the clipboard, but a TextInput can
    // copy its own selection: so text bound for the clipboard is put in this
    // hidden one, selected, and copied.
    clipper := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }
    property <int> clip-watch: Passage.clip-epoch;
    changed clip-watch => {
        clipper.text = Passage.clip;
        clipper.select-all();
        clipper.copy();
    }
    // Touch: a word held this long starts a selection. The press reaches the
    // word 100 ms after the finger lands (the scroller waits that long to see
    // whether it is a drag), and the scroller stops claiming drags 500 ms in,
    // so the hold ends just after: from then on, a drag selects.
    Timer {
        interval: 450ms;
        running: Passage.armed;
        triggered => { Passage.hold(); }
    }

    // Starting a selection takes the keys back from any text selected before,
    // so the Ctrl+C that follows copies the new selection.
    property <int> focus-watch: Passage.focus-epoch;
    changed focus-watch => { shortcuts.focus(); }

    shortcuts := FocusScope {
        capture-key-pressed(event) => {
            // Text size, as in a browser: Ctrl+plus, Ctrl+minus, and Ctrl+=
            // (or Ctrl+0) for the normal size. On most layouts plus is
            // Shift+=, so plain Ctrl+= is free to mean "reset".
            if (event.modifiers.control && (event.text == "+" || event.text == "-" || event.text == "=" || event.text == "0")) {
                if (event.text == "+") {
                    Theme.zoom-by(1);
                } else if (event.text == "-") {
                    Theme.zoom-by(-1);
                } else {
                    Theme.zoom = 1.0;
                }
                root.zoom-changed();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                if (event.modifiers.shift) {
                    root.toggle-advanced();
                } else {
                    root.focus-search += 1;
                }
                return accept;
            }
            // Page Down / Page Up — also what the page-turn buttons of many
            // e-readers send — read on a screenful at a time.
            if (!root.show-results && (event.text == Key.PageDown || event.text == Key.PageUp)) {
                Paging.turn(event.text == Key.PageDown ? 1 : -1);
                return accept;
            }
            if (event.text == Key.Back) {
                return root.go-back() ? accept : reject;
            }
            reject
        }
        // Bubbling, not capturing: a focused text copies its own selection,
        // and only otherwise do the selected words or marked verses go.
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                return Passage.copy-selection() ? accept : reject;
            }
            if (event.text == Key.Escape && Passage.has-selection) {
                Passage.clear();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---------------- Top bar ----------------
            Rectangle {
                height: Theme.touch ? 60px : 52px;
                background: Theme.panel;
                border-width: 0px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    // Each item is vertically centered so the logo, search box and
                    // buttons share one baseline across the bar.
                    // A touch screen can fold the sidebar away.
                    if Theme.touch: VerticalLayout {
                        alignment: center;
                        Pill {
                            label: "☰ Books";
                            active: root.compact ? root.drawer-open : root.show-sidebar;
                            clicked => { root.toggle-sidebar(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("logo.svg");
                                width: 28px;
                                height: 28px;
                            }
                        }
                        if !root.compact: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "LeVerbe";
                                color: Theme.accent;
                                font-size: 18px;
                                font-weight: 700;
                            }
                        }
                    }
                    // command / search box
                    Rectangle {
                        horizontal-stretch: 1;
                        property <int> focus-watch: root.focus-search;
                        changed focus-watch => { cmd.focus(); cmd.select-all(); }
                        VerticalLayout {
                            alignment: center;
                            cmd := LineEdit {
                                placeholder-text: Theme.touch
                                    ? "Go to a reference (John 3:16), or search"
                                    : "Go to reference (John 3:16), search, or query — Ctrl+Shift+F for the language";
                                text <=> root.command;
                                accepted(t) => { root.go(t); }
                            }
                        }
                    }
                    if !root.compact: Tools {
                        advanced: root.advanced;
                        show-import <=> root.show-import;
                        can-import: root.can-import;
                        column-count: root.columns.length;
                        reader-available: root.reader-available;
                        reader: root.reader;
                        scroll-lock: root.scroll-lock;
                        toggle-advanced => { root.toggle-advanced(); }
                        add-column => { root.add-column(); }
                        toggle-reader => { root.toggle-reader(); }
                        toggle-scroll-lock => { root.toggle-scroll-lock(); }
                        toggle-theme => { root.toggle-theme(); }
                        zoom-changed => { root.zoom-changed(); }
                    }
                }
            }
            // narrow: the buttons on a row of their own
            if root.compact: Rectangle {
                height: Theme.target + 12px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: start;
                    Tools {
                        short: true;
                        advanced: root.advanced;
                        show-import <=> root.show-import;
                        can-import: root.can-import;
                        column-count: root.columns.length;
                        reader-available: root.reader-available;
                        reader: root.reader;
                        scroll-lock: root.scroll-lock;
                        toggle-advanced => { root.toggle-advanced(); }
                        add-column => { root.add-column(); }
                        toggle-reader => { root.toggle-reader(); }
                        toggle-scroll-lock => { root.toggle-scroll-lock(); }
                        toggle-theme => { root.toggle-theme(); }
                        zoom-changed => { root.zoom-changed(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ---------------- Advanced search: the language, on a card ----------------
            if root.advanced: Rectangle {
                background: Theme.panel-alt;
                VerticalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Advanced search — type a query in the box above and press Enter. It runs on the Hebrew OT / Greek NT; hits are shown in the translation you are reading, with the matching words marked.";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Pill { label: "✕"; clicked => { root.toggle-advanced(); } }
                    }
                    if !root.compact: HorizontalLayout {
                        spacing: 28px;
                        QueryWords { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
                        QueryMorphology { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
                        QueryCombining {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            try(q) => { root.try-query(q); }
                        }
                    }
                    if root.compact: VerticalLayout {
                        spacing: 12px;
                        QueryWords { }
                        QueryMorphology { }
                        QueryCombining { try(q) => { root.try-query(q); } }
                    }
                }
            }
            if root.advanced: Rectangle { height: 1px; background: Theme.border; }

            // ---------------- Body ----------------
            HorizontalLayout {
                // -------- Sidebar --------
                if root.docked-sidebar: Sidebar {
                    width: Theme.touch ? 330px : 270px;
                    reader-on: root.reader && root.reader-available;
                    threshold-labels: root.threshold-labels;
                    threshold-index: root.threshold-index;
                    books: root.books;
                    chapters: root.chapters;
                    current-book: root.current-book;
                    current-chapter: root.current-chapter;
                    threshold-changed(i) => { root.threshold-changed(i); }
                    select-book(nr) => { root.select-book(nr); }
                    select-chapter(ch) => { root.select-chapter(ch); }
                }
                if root.docked-sidebar: Rectangle { width: 1px; background: Theme.border; }

                // -------- Reading / results area --------
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;

                    // Both views stay instantiated and only switch visibility.
                    // An `if` would tear them down: the results list would
                    // forget its scroll position every time a hit is opened,
                    // and the reading view would be recreated *after* the
                    // navigation epoch bumped, so it would never land on the
                    // hit's verse.

                    // ----- Search results -----
                    VerticalLayout {
                        visible: root.show-results;
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.results-summary;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Pill { label: "✕ Close"; clicked => { root.close-results(); } }
                        }
                        ListView {
                            vertical-stretch: 1;
                            preferred-height: 0px;   // see VerseScroller: no % preferred
                            // back to the top for a new search only; coming
                            // back from a hit keeps the place
                            property <int> search-watch: root.search-epoch;
                            changed search-watch => { self.content-y = 0px; }
                            for r[i] in root.results: Rectangle {
                                height: rlayout.preferred-height;
                                background: (rtouch.has-hover && !Theme.touch) ? Theme.panel : transparent;
                                border-radius: 6px;
                                rlayout := VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text {
                                        text: r.label;
                                        color: Theme.accent;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    for line in r.lines: HorizontalLayout {
                                        spacing: 3px;
                                        alignment: r.rtl ? end : start;
                                        for w in line.words: Rectangle {
                                            border-radius: 3px;
                                            background: w.hit ? Theme.accent-bg : transparent;
                                            HorizontalLayout {
                                                padding-left: 3px;
                                                padding-right: 3px;
                                                Text {
                                                    text: w.text;
                                                    color: w.hit ? Theme.accent : Theme.text;
                                                    font-size: 14px;
                                                    font-weight: w.hit ? 700 : 400;
                                                }
                                            }
                                        }
                                    }
                                }
                                rtouch := TouchArea { clicked => { root.open-result(i); } }
                            }
                        }
                    }

                    // ----- Reading view -----
                    VerticalLayout {
                        visible: !root.show-results;
                        // chapter header with prev/next, and on a touch screen
                        // the page buttons
                        Rectangle {
                            height: Theme.touch ? 56px : 44px;
                            HorizontalLayout {
                                // the taller buttons centred in the taller bar
                                padding-top: Theme.touch ? 8px : 0px;
                                padding-bottom: Theme.touch ? 8px : 0px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;
                                if root.has-results: Pill {
                                    label: root.compact ? "☰" : "☰ Results";
                                    active: true;
                                    clicked => { root.show-results = true; }
                                }
                                Pill { label: root.compact ? "‹" : "‹ Prev"; clicked => { root.prev-chapter(); } }
                                if Theme.touch: Pill { label: "▲ Page"; clicked => { Paging.turn(-1); } }
                                Text {
                                    text: root.primary-title;
                                    color: Theme.text;
                                    font-size: 17px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: center;
                                }
                                if Theme.touch: Pill { label: "▼ Page"; clicked => { Paging.turn(1); } }
                                Pill { label: root.compact ? "›" : "Next ›"; clicked => { root.next-chapter(); } }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }

                        // A pinch sizes the text; it is applied when the
                        // fingers lift, so the chapter is laid out once
                        // rather than at every step — an e-ink screen would
                        // redraw it each time.
                        pinch := ScaleRotateGestureHandler {
                            vertical-stretch: 1;
                            enabled: Theme.touch;
                            property <float> base: 1.0;
                            property <float> wanted: max(Theme.min-zoom, min(Theme.max-zoom, round(self.base * self.scale * 10) / 10));
                            started => { self.base = Theme.zoom; }
                            ended => {
                                Theme.zoom = self.wanted;
                                root.zoom-changed();
                            }
                            ParallelColumns {
                                width: 100%;
                                height: 100%;
                                translation-labels: root.translation-labels;
                                columns: root.columns;
                                pairs: root.pairs;
                                scroll-lock: root.scroll-lock;
                                selected-col: root.selected-col;
                                selected-idx: root.selected-idx;
                                nav-epoch: root.nav-epoch;
                                target-index: root.target-index;
                                pick(c, i) => { root.word-clicked(c, i); }
                                translation-changed(c, t) => { root.translation-changed(c, t); }
                                remove-column(c) => { root.remove-column(c); }
                            }
                            if pinch.active: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 24px;
                                width: 140px;
                                height: 40px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 8px;
                                Text {
                                    text: "Text " + round(pinch.wanted * 100) + "%";
                                    color: Theme.text;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.reader && root.reader-available: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if root.reader && root.reader-available: GlossPane {
                            // fixed, not a share of the parent: as a layout child, reading the
                            // parent's height here is a binding loop with the window's preferred size
                            // a tablet's page is taller, and its glosses
                            // are read instead of a lexicon
                            height: Theme.touch ? 380px : 240px;
                            notes: root.notes;
                            caption: root.reader-caption;
                        }

                        // Touch: what Ctrl+C and the right-click menus do,
                        // for whatever is selected.
                        if Theme.touch && Passage.has-selection: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if Theme.touch && Passage.has-selection: Rectangle {
                            height: Theme.target + 16px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;
                                Text {
                                    text: Passage.summary;
                                    color: Theme.text;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        label: "Copy";
                                        active: true;
                                        clicked => {
                                            Passage.copy-selection();
                                            Passage.clear();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        label: "Copy chapter";
                                        clicked => {
                                            Passage.copy-verses(max(Passage.column, Passage.word-column), 0, 0);
                                            Passage.clear();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        label: "✕";
                                        clicked => { Passage.clear(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // -------- Word-study panel --------
                if root.show-word && !root.compact: Rectangle { width: 1px; background: Theme.border; }
                if root.show-word && !root.compact: WordPanel {
                    width: 340px;
                    word: root.word;
                    close => { root.close-word(); }
                }
            }
        }

        // ---------------- Narrow screen: the panes over the text ----------------
        // They appear and go at once, with no slide: an e-ink screen would
        // draw every step of one.
        if root.compact && root.drawer-open: Rectangle {
            // e-ink renders a translucent shade as grey speckle; a rule says
            // as much
            background: Theme.eink ? transparent : #00000055;
            TouchArea { clicked => { root.drawer-open = false; } }
            Sidebar {
                x: 0;
                width: min(330px, parent.width - 48px);
                height: parent.height;
                reader-on: root.reader && root.reader-available;
                threshold-labels: root.threshold-labels;
                threshold-index: root.threshold-index;
                books: root.books;
                chapters: root.chapters;
                current-book: root.current-book;
                current-chapter: root.current-chapter;
                threshold-changed(i) => { root.threshold-changed(i); }
                select-book(nr) => { root.select-book(nr); }
                // a chapter is the last choice made here
                select-chapter(ch) => {
                    root.select-chapter(ch);
                    root.drawer-open = false;
                }
                // clicks on the drawer stay on the drawer
                TouchArea { z: -1; }
            }
            Rectangle {
                x: min(330px, parent.width - 48px);
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }
        }
        if root.compact && root.show-word: Rectangle {
            background: Theme.eink ? transparent : #00000055;
            TouchArea { clicked => { root.close-word(); } }
            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }
            WordPanel {
                x: parent.width - self.width;
                width: min(380px, parent.width - 48px);
                height: parent.height;
                word: root.word;
                close => { root.close-word(); }
                TouchArea { z: -1; }
            }
        }

        // ---------------- Importing a translation: a card over the page ----------------
        if root.show-import: Rectangle {
            background: #00000088;
            // a click beside the card closes it, unless an import is running
            TouchArea {
                clicked => {
                    if (root.import-stage != 2) {
                        root.show-import = false;
                    }
                }
            }
            Rectangle {
                // the window is never narrower than 720px
                width: 600px;
                height: card.preferred-height;
                x: (parent.width - self.width) / 2;
                y: 70px;
                background: Theme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                // clicks on the card stay on the card
                TouchArea { }
                card := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            text: "Import a translation";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.import-stage != 2: Pill {
                            label: "✕";
                            clicked => { root.show-import = false; }
                        }
                    }

                    // ---- 0: choose a file, or manage the imported ones ----
                    if root.import-stage == 0: VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Bring in a Bible you own: an EPUB, a PDF, a Logos personal-book DOCX or a text file. Its words are linked to the Hebrew and Greek so they can be clicked like the others. It stays on this computer.";
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            // A layout measures wrapped text at its own
                            // preferred width, which an unwrapped line would
                            // otherwise set: the card's inner width.
                            preferred-width: 560px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Pill {
                                label: "Choose a file…";
                                active: true;
                                clicked => { root.import-choose(); }
                            }
                        }
                        if root.imported.length > 0: Text {
                            text: "IMPORTED";
                            color: Theme.muted;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        // a fixed height: the card sizes itself to its content,
                        // and rows a repeater adds are not counted otherwise
                        for t in root.imported: row := Rectangle {
                            height: 32px;
                            property <bool> confirming: root.removing == t.code;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: t.code;
                                    width: 80px;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: t.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                // removing takes a second click: it cannot be undone
                                Pill {
                                    label: row.confirming ? "Remove — sure?" : "Remove";
                                    active: row.confirming;
                                    clicked => {
                                        if (row.confirming) {
                                            root.removing = "";
                                            root.import-remove(t.code);
                                        } else {
                                            root.removing = t.code;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- 1: what was read, and what to call it ----
                    if root.import-stage == 1: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.import-file;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: root.import-summary;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                            // A layout measures wrapped text at its own
                            // preferred width, which an unwrapped line would
                            // otherwise set: the card's inner width.
                            preferred-width: 560px;
                        }
                        if root.import-notes != "": Text {
                            text: root.import-notes;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            // A layout measures wrapped text at its own
                            // preferred width, which an unwrapped line would
                            // otherwise set: the card's inner width.
                            preferred-width: 560px;
                        }
                        GridLayout {
                            spacing: 8px;
                            Row {
                                Text { text: "Name"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> root.import-name; }
                            }
                            Row {
                                Text { text: "Code"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> root.import-code; placeholder-text: "2 to 12 capitals, e.g. NASB"; }
                            }
                            Row {
                                Text { text: "Language"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> root.import-lang; placeholder-text: "en, fr, nb, de…"; }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Pill {
                                label: "Cancel";
                                clicked => { root.import-reset(); }
                            }
                            Pill {
                                label: "Import";
                                active: true;
                                clicked => { root.import-confirm(); }
                            }
                        }
                    }

                    // ---- 2: importing ----
                    if root.import-stage == 2: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.import-progress-text;
                            color: Theme.text;
                            font-size: 13px;
                        }
                        // a negative progress: reading the file, length unknown
                        ProgressIndicator {
                            height: 6px;
                            progress: max(0, root.import-progress);
                            indeterminate: root.import-progress < 0;
                        }
                    }

                    // ---- 3: done ----
                    if root.import-stage == 3: VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: root.import-summary;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            // A layout measures wrapped text at its own
                            // preferred width, which an unwrapped line would
                            // otherwise set: the card's inner width.
                            preferred-width: 560px;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Pill {
                                label: "Import another";
                                clicked => { root.import-reset(); }
                            }
                            Pill {
                                label: "Open in a new column";
                                active: true;
                                clicked => { root.import-open(); }
                            }
                        }
                    }

                    if root.import-error != "": Text {
                        text: root.import-error;
                        color: Theme.danger;
                        font-size: 13px;
                        wrap: word-wrap;
                        preferred-width: 560px;
                    }
                }
            }
        }

        // ---------------- First launch on a tablet: unpacking the Bible ----------------
        if root.preparing: Rectangle {
            background: Theme.bg;
            // nothing underneath is ready to be touched
            TouchArea { }
            VerticalLayout {
                alignment: center;
                padding: 32px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("logo.svg");
                        width: 64px;
                        height: 64px;
                    }
                }
                Text {
                    text: root.prepare-error != "" ? "LeVerbe could not prepare its Bible" : "Preparing the Bible for first use…";
                    color: Theme.text;
                    font-size: 20px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.prepare-error != "" ? root.prepare-error : "This happens once, and takes a minute at most.";
                    color: root.prepare-error != "" ? Theme.danger : Theme.muted;
                    font-size: 15px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                // A bar that moves in steps rather than an animation: an
                // e-ink screen redraws for every frame of one.
                HorizontalLayout {
                    alignment: center;
                    if root.prepare-error == "": Rectangle {
                        width: 320px;
                        height: 10px;
                        border-width: 1px;
                        border-color: Theme.text;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(1, root.prepare-progress));
                            background: Theme.text;
                        }
                    }
                }
            }
        }
    }
}
