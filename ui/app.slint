import { ComboBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme — all colours derive from a single `dark` switch.
// ---------------------------------------------------------------------------
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:        dark ? #1b1c1f : #fcfbf8;
    out property <color> panel:     dark ? #232428 : #f2f0ea;
    out property <color> panel-alt: dark ? #2b2d32 : #e9e6dd;
    out property <color> border:    dark ? #36383e : #ddd8cc;
    out property <color> text:      dark ? #e8e8ea : #1f2329;
    out property <color> muted:     dark ? #9499a1 : #6c7177;
    out property <color> accent:    dark ? #6ea8fe : #2563eb;
    out property <color> accent-bg: dark ? #2a3550 : #e2ecff;
    out property <color> verse-num: dark ? #7d838d : #9aa0a6;

    out property <length> reading-size: 17px;
}

// ---------------------------------------------------------------------------
// Shared data structs (mirrored by Rust)
// ---------------------------------------------------------------------------
export struct TranslationItem { code: string, name: string }
export struct BookItem { nr: int, name: string, header: bool }
export struct SearchItem { label: string, snippet: string, book: int, chapter: int, verse: int }

// Word-level (tagged original-language) structures. Verses are pre-wrapped
// into lines on the Rust side (Slint has no flow layout).
export struct WordChip { idx: int, text: string, tagged: bool }
export struct WordLine { words: [WordChip] }

// One row of a reading column. A row is either plain prose (`text`) or a
// sequence of clickable, morphology-tagged words (`lines`) — never both.
// Both kinds share one model so that a column is a single ListView, which is
// what lets the two columns lock their scroll positions to each other.
export struct VerseRow {
    verse: int,
    text: string,
    lines: [WordLine],
    tagged: bool,
    rtl: bool,
}
export struct OriginalWord { text: string, parsing: string }
export struct WordInfo {
    surface: string, translit: string, lemma: string, strongs: string,
    parsing: string, gloss: string, definition: string,
    rtl: bool,          // direction of the clicked surface word
    orig-rtl: bool,     // direction of the original-language script (lemma/originals)
    originals-label: string,
    originals: [OriginalWord],
    lxx: string,
    show-lxx: bool,
    vulgate: string,
    show-vulgate: bool,
}

// ---------------------------------------------------------------------------
// A small text button / pill.
// ---------------------------------------------------------------------------
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 28px;
    border-radius: 6px;
    background: active ? Theme.accent-bg : (touch.has-hover ? Theme.panel-alt : transparent);
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: active ? Theme.accent : Theme.text;
            vertical-alignment: center;
            font-size: 13px;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------------------
// One reading column: a scrollable list of verses. Rows are either plain
// prose or clickable, morphology-tagged words, depending on the row itself —
// keeping it one ListView is what makes the column addressable for scroll
// locking (elements inside a Slint `if` cannot be reached by name).
// ---------------------------------------------------------------------------
component ReadingColumn inherits ListView {
    in property <[VerseRow]> rows;
    in property <int> column;          // 0 = primary, 1 = secondary
    in property <int> selected-col;
    in property <int> selected-idx;
    callback pick(int, int);           // (column, word index)

    for r in rows: Rectangle {
        // declared first so the word chips above it keep their own clicks
        vtouch := TouchArea { }
        background: (!r.tagged && vtouch.has-hover) ? Theme.panel : transparent;
        HorizontalLayout {
            padding: r.tagged ? 5px : 4px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: r.tagged ? 8px : 10px;

            // verse number — leading, except for right-to-left word rows
            if !r.tagged || !r.rtl: Text {
                text: r.verse;
                width: r.tagged ? 26px : 30px;
                color: Theme.verse-num;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: top;
                // nudge the small number to sit on the text baseline
                y: r.tagged ? 4px : 3px;
            }

            if !r.tagged: Text {
                text: r.text;
                color: Theme.text;
                font-size: Theme.reading-size;
                wrap: word-wrap;
                horizontal-stretch: 1;
                horizontal-alignment: r.rtl ? right : left;
            }

            if r.tagged: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                for line in r.lines: HorizontalLayout {
                    spacing: 3px;
                    alignment: r.rtl ? end : start;
                    for w in line.words: Rectangle {
                        border-radius: 4px;
                        background: (root.column == root.selected-col && w.idx == root.selected-idx)
                            ? Theme.accent-bg
                            : (wtouch.has-hover ? Theme.panel-alt : transparent);
                        HorizontalLayout {
                            padding: 1px;
                            padding-left: 3px;
                            padding-right: 3px;
                            Text {
                                text: w.text;
                                font-size: Theme.reading-size;
                                color: w.tagged ? Theme.text : Theme.muted;
                            }
                        }
                        wtouch := TouchArea {
                            clicked => { root.pick(root.column, w.idx); }
                        }
                    }
                }
            }

            if r.tagged && r.rtl: Text {
                text: r.verse;
                width: 26px;
                color: Theme.verse-num;
                font-size: 12px;
                y: 4px;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The reading area: one column, or two side by side with their scrolling
// locked together.
//
// Both columns are always instantiated and placed by hand instead of being
// wrapped in `if parallel`, and they are direct children of this component so
// that each can reach the other by id — Slint scopes ids to the element that
// encloses them, and hides the ones declared inside a conditional entirely.
// ---------------------------------------------------------------------------
component ParallelColumns inherits Rectangle {
    in property <[VerseRow]> rows;
    in property <[VerseRow]> rows2;
    in property <bool> parallel;
    in property <bool> scroll-lock;
    in property <string> subtitle;
    in property <string> subtitle2;
    in property <int> selected-col;
    in property <int> selected-idx;
    /// Bumped by Rust on every navigation; sends both columns back to the top.
    in property <int> nav-epoch;
    callback pick(int, int);           // (column, word index)

    property <length> head-h: root.parallel ? 30px : 0px;
    property <length> w1: root.parallel ? (self.width - 1px) / 2 : self.width;
    property <length> w2: max(0px, self.width - self.w1 - 1px);

    // --- scroll locking ----------------------------------------------------
    // Both columns hold the same chapter, so mapping "rows scrolled past"
    // from one to the other keeps the same verse at the top even when the two
    // texts differ wildly in height (tagged word chips wrap much taller than
    // prose). A ListView reports viewport-height as rows × the average height
    // of the rows it has measured, which is exactly the scale we need.
    //
    // The sync hangs off `scrolled`, which a ScrollView only emits for real
    // input — wheel, drag, scrollbar. Watching viewport-y instead would also
    // catch the ListView re-anchoring itself as it refines its height
    // estimate, and those corrections would bounce between the columns.
    property <length> row-h1: root.rows.length > 0 ? col1.viewport-height / root.rows.length : 0px;
    property <length> row-h2: root.rows2.length > 0 ? col2.viewport-height / root.rows2.length : 0px;
    // most negative viewport-y each column can take (0px = top)
    property <length> floor1: min(0px, col1.visible-height - col1.viewport-height);
    property <length> floor2: min(0px, col2.visible-height - col2.viewport-height);
    property <bool> lock-active: root.parallel && root.scroll-lock
        && root.row-h1 > 0px && root.row-h2 > 0px;

    function push-secondary() {
        col2.viewport-y = max(root.floor2, min(0px, col1.viewport-y * (root.row-h2 / root.row-h1)));
    }

    function push-primary() {
        col1.viewport-y = max(root.floor1, min(0px, col2.viewport-y * (root.row-h1 / root.row-h2)));
    }

    // Re-align when the lock is switched back on, rather than leaving the
    // columns apart until the next scroll.
    property <bool> lock-watch: root.scroll-lock;
    changed lock-watch => {
        if (root.lock-watch && root.lock-active) {
            root.push-secondary();
        }
    }

    property <int> epoch-watch: root.nav-epoch;
    changed epoch-watch => {
        col1.viewport-y = 0px;
        col2.viewport-y = 0px;
    }

    // --- layout ------------------------------------------------------------
    Rectangle {
        x: 0;
        y: 0;
        width: root.w1;
        height: root.head-h;
        visible: root.parallel;
        Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    col1 := ReadingColumn {
        x: 0;
        y: root.head-h;
        width: root.w1;
        height: root.height - root.head-h;
        rows: root.rows;
        column: 0;
        selected-col: root.selected-col;
        selected-idx: root.selected-idx;
        pick(c, i) => { root.pick(c, i); }
        scrolled => {
            if (root.lock-active) {
                root.push-secondary();
            }
        }
    }

    Rectangle {
        x: root.w1;
        y: 0;
        width: 1px;
        height: root.height;
        background: Theme.border;
        visible: root.parallel;
    }

    Rectangle {
        x: root.w1 + 1px;
        y: 0;
        width: root.w2;
        height: root.head-h;
        visible: root.parallel;
        Text {
            text: root.subtitle2;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    col2 := ReadingColumn {
        x: root.w1 + 1px;
        y: root.head-h;
        width: root.w2;
        height: root.height - root.head-h;
        visible: root.parallel;
        rows: root.rows2;
        column: 1;
        selected-col: root.selected-col;
        selected-idx: root.selected-idx;
        pick(c, i) => { root.pick(c, i); }
        scrolled => {
            if (root.lock-active) {
                root.push-primary();
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "Logos-rs";
    preferred-width: 1200px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg;

    // --- data in from Rust ---
    in property <[TranslationItem]> translations;
    in property <[string]> translation-labels;
    in property <[BookItem]> books;
    in property <[int]> chapters;
    in property <[VerseRow]> rows;      // primary column
    in property <[VerseRow]> rows2;     // secondary column (parallel only)
    in property <[SearchItem]> results;

    // word study
    in property <WordInfo> word;
    in-out property <bool> show-word;
    in-out property <int> selected-col: -1;
    in-out property <int> selected-idx: -1;
    in property <string> primary-title;
    in property <string> primary-subtitle;
    in property <string> secondary-title;
    in property <string> results-summary;

    in-out property <int> current-book;
    in-out property <int> current-chapter;
    in-out property <bool> parallel;
    in-out property <bool> show-results;
    in-out property <string> command;

    // --- parallel scroll locking ---
    // On by default: scrolling either column moves the other to the same
    // verse. Rust resets both columns to the top on navigation.
    in-out property <bool> scroll-lock: true;
    /// Bumped by Rust whenever the passage changes, to send both columns back
    /// to the top of the new chapter.
    in property <int> nav-epoch;

    // --- callbacks to Rust ---
    callback select-book(int);
    callback select-chapter(int);
    callback go(string);
    callback open-result(int);
    callback primary-changed(int);
    callback secondary-changed(int);
    callback toggle-parallel();
    callback toggle-theme();
    callback prev-chapter();
    callback next-chapter();
    callback close-results();
    callback word-clicked(int, int);  // (column, word index)
    callback close-word();

    VerticalLayout {
        // ---------------- Top bar ----------------
        Rectangle {
            height: 52px;
            background: Theme.panel;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                // Each item is vertically centered so the logo, search box and
                // buttons share one baseline across the 52px bar.
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "✝ Logos";
                        color: Theme.accent;
                        font-size: 18px;
                        font-weight: 700;
                    }
                }
                // command / search box
                Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        cmd := LineEdit {
                            placeholder-text: "Go to reference (John 3:16) or search…";
                            text <=> root.command;
                            accepted(t) => { root.go(t); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        label: root.parallel ? "Parallel ✓" : "Parallel";
                        active: root.parallel;
                        clicked => { root.toggle-parallel(); }
                    }
                }
                if root.parallel: VerticalLayout {
                    alignment: center;
                    Pill {
                        label: root.scroll-lock ? "🔗 Linked" : "⛓ Unlinked";
                        active: root.scroll-lock;
                        clicked => { root.scroll-lock = !root.scroll-lock; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        label: Theme.dark ? "☀ Light" : "🌙 Dark";
                        clicked => { root.toggle-theme(); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---------------- Body ----------------
        HorizontalLayout {
            // -------- Sidebar --------
            Rectangle {
                width: 270px;
                background: Theme.panel;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // translation pickers
                    Text { text: "Primary translation"; color: Theme.muted; font-size: 11px; }
                    ComboBox {
                        model: root.translation-labels;
                        current-index: 0;
                        selected(v) => { root.primary-changed(self.current-index); }
                    }
                    if root.parallel: Text { text: "Secondary translation"; color: Theme.muted; font-size: 11px; }
                    if root.parallel: ComboBox {
                        model: root.translation-labels;
                        current-index: 1;
                        selected(v) => { root.secondary-changed(self.current-index); }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // book list
                    Text { text: "Books"; color: Theme.muted; font-size: 11px; }
                    ListView {
                        vertical-stretch: 1;
                        for b[i] in root.books: Rectangle {
                            height: b.header ? 30px : 26px;
                            background: (!b.header && b.nr == root.current-book)
                                ? Theme.accent-bg
                                : (btouch.has-hover && !b.header ? Theme.panel-alt : transparent);
                            border-radius: 5px;
                            HorizontalLayout {
                                padding-left: b.header ? 4px : 12px;
                                Text {
                                    text: b.name;
                                    vertical-alignment: center;
                                    font-size: b.header ? 11px : 14px;
                                    font-weight: b.header ? 700 : 400;
                                    color: b.header
                                        ? Theme.muted
                                        : (b.nr == root.current-book ? Theme.accent : Theme.text);
                                }
                            }
                            btouch := TouchArea {
                                enabled: !b.header;
                                clicked => { root.select-book(b.nr); }
                            }
                        }
                    }

                    // chapter grid
                    Text {
                        text: "Chapters";
                        color: Theme.muted;
                        font-size: 11px;
                        visible: root.chapters.length > 0;
                    }
                    // Sizes to fit all chapters; caps and scrolls only when the
                    // grid would get too tall (e.g. Psalms' 150 chapters).
                    // viewport-height must be set explicitly: the cells are
                    // absolutely positioned, so the ScrollView can't infer it.
                    csv := ScrollView {
                        property <int> cols: 7;
                        property <length> cell: 34px;
                        property <length> content-h: Math.ceil(root.chapters.length / self.cols) * self.cell;
                        visible: root.chapters.length > 0;
                        viewport-width: self.cols * self.cell;
                        viewport-height: self.content-h;
                        height: Math.min(self.content-h + 2px, 300px);
                        for ch[i] in root.chapters: Rectangle {
                            x: Math.mod(i, csv.cols) * csv.cell;
                            y: Math.floor(i / csv.cols) * csv.cell;
                            width: csv.cell - 4px;
                            height: csv.cell - 4px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: ch == root.current-chapter ? Theme.accent : Theme.border;
                            background: ch == root.current-chapter
                                ? Theme.accent-bg
                                : (chtouch.has-hover ? Theme.panel-alt : transparent);
                            Text {
                                text: ch;
                                font-size: 12px;
                                color: ch == root.current-chapter ? Theme.accent : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            chtouch := TouchArea { clicked => { root.select-chapter(ch); } }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }

            // -------- Reading / results area --------
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;

                // ----- Search results -----
                if root.show-results: VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.results-summary;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Pill { label: "✕ Close"; clicked => { root.close-results(); } }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for r[i] in root.results: Rectangle {
                            height: rlayout.preferred-height;
                            background: rtouch.has-hover ? Theme.panel : transparent;
                            border-radius: 6px;
                            rlayout := VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text {
                                    text: r.label;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: r.snippet;
                                    color: Theme.text;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                            rtouch := TouchArea { clicked => { root.open-result(i); } }
                        }
                    }
                }

                // ----- Reading view -----
                if !root.show-results: VerticalLayout {
                    // chapter header with prev/next
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;
                            Pill { label: "‹ Prev"; clicked => { root.prev-chapter(); } }
                            Text {
                                text: root.primary-title;
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                horizontal-alignment: center;
                            }
                            Pill { label: "Next ›"; clicked => { root.next-chapter(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }

                    ParallelColumns {
                        vertical-stretch: 1;
                        rows: root.rows;
                        rows2: root.rows2;
                        parallel: root.parallel;
                        scroll-lock: root.scroll-lock;
                        subtitle: root.primary-subtitle;
                        subtitle2: root.secondary-title;
                        selected-col: root.selected-col;
                        selected-idx: root.selected-idx;
                        nav-epoch: root.nav-epoch;
                        pick(c, i) => { root.word-clicked(c, i); }
                    }
                }
            }

            // -------- Word-study panel --------
            if root.show-word: Rectangle { width: 1px; background: Theme.border; }
            if root.show-word: Rectangle {
                width: 340px;
                background: Theme.panel;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: "Word study";
                            color: Theme.muted;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Pill { label: "✕"; clicked => { root.close-word(); } }
                    }
                    Text {
                        text: root.word.surface;
                        color: Theme.text;
                        font-size: 30px;
                        horizontal-alignment: root.word.rtl ? right : left;
                    }
                    if root.word.translit != "": Text {
                        text: root.word.translit;
                        color: Theme.muted;
                        font-size: 15px;
                    }
                    if root.word.strongs != "": HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            background: Theme.accent-bg;
                            border-radius: 5px;
                            height: 22px;
                            horizontal-stretch: 0;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.word.strongs;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.word.lemma;
                            color: Theme.text;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    if root.word.parsing != "": Text {
                        text: root.word.parsing;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    // matching original-language word(s) — reverse interlinear
                    if root.word.originals-label != "": Text {
                        text: root.word.originals-label;
                        color: Theme.muted;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    for o in root.word.originals: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: o.text;
                            color: Theme.accent;
                            font-size: 22px;
                        }
                        Text {
                            text: o.parsing;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.word.gloss != "": Text {
                        text: root.word.gloss;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: 100%;
                            spacing: 8px;
                            Text {
                                width: 100%;
                                text: root.word.definition;
                                color: Theme.muted;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            if root.word.show-lxx: Text {
                                text: "Septuagint (LXX)";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            if root.word.show-lxx: Text {
                                width: 100%;
                                text: root.word.lxx;
                                color: Theme.text;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                            if root.word.show-vulgate: Text {
                                text: "Vulgate (Latin)";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            if root.word.show-vulgate: Text {
                                width: 100%;
                                text: root.word.vulgate;
                                color: Theme.text;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
